{
  "name": "english-schedule",
  "version": "1.0.0",
  "main": "index.js",
  "description": "Playwright E2E Test Automation Framework with Page Object Model",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:login": "playwright test login.spec.ts",
    "test:schedule": "playwright test sheduleClass.spec.ts",
    "report": "playwright show-report",
    "clean": "rm -rf test-results playwright-report",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "e2e",
    "typescript",
    "page-object-model"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.2",
    "dotenv": "^17.2.4"
  }
}
